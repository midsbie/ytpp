#!/bin/bash

set -euo pipefail

detect_browser() {
    local desktop
    desktop="$(xdg-settings get default-web-browser 2>/dev/null)" || return 1
    case "$desktop" in
        firefox*)           echo firefox ;;
        google-chrome*)     echo chrome ;;
        chromium*)          echo chromium ;;
        brave*)             echo brave ;;
        *)                  return 1 ;;
    esac
}

usage() { echo "Usage: ytcks [--cookies <path>] [browser]" >&2; exit 1; }

cookies="cookies.txt"
positional=()
while (( $# > 0 )); do
    case "$1" in
        --cookies) cookies="${2:-}"; shift 2 ;;
        --cookies=*) cookies="${1#--cookies=}"; shift ;;
        *) positional+=("$1"); shift ;;
    esac
done

(( ${#positional[@]} <= 1 )) || usage

if (( ${#positional[@]} == 1 )); then
    BROWSER="${positional[0]}"
else
    BROWSER="$(detect_browser)" || { echo "Could not detect default browser; pass one explicitly." >&2; exit 1; }
fi

yt-dlp --cookies-from-browser "$BROWSER" --cookies "$cookies" --skip-download "TwEL7LkeNqU"
sed -i '/^#/!{ /^\.youtube\.com\s/!{ /^\.google\.com\s/!d; }; }' "$cookies"
chmod 600 "$cookies"
